# ── Frontend environment (Vite) ──────────────────────────────────────────────
# Copy to .env.local for local dev, and set the same keys in the Vercel project
# (Settings → Environment Variables) for production builds.

# Optional: override the API base URL. Defaults to /api in prod, localhost:5000 in dev.
# VITE_API_URL=https://triprodeo.co.in/api

# ── Image storage (Supabase Storage) ─────────────────────────────────────────
# When BOTH of these are set, property/room/add-on/day-package images upload
# directly from the browser to Supabase Storage and only their public URL is
# saved on the property — removing the request-body size limit on saves.
# When they are absent, images fall back to compressed inline data URLs.
#
# Setup (one time):
#   1. In your Supabase project → Storage → create a PUBLIC bucket named
#      "property-images" (or set VITE_SUPABASE_BUCKET to your bucket name).
#   2. Add an INSERT policy so the anon role can upload to that bucket
#      (see SUPABASE_STORAGE_SETUP.md for the exact SQL).
#   3. Fill in the two values below from Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional — defaults to "property-images".
# VITE_SUPABASE_BUCKET=property-images
